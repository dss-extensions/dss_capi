        // Added on DSS-Extensions (API Extensions)
        [id(0x00000a01), propget, helpstring("Only affects the AltDSS engine. If disabled, the engine will not change the active working directory during execution. E.g. a `compile` command will not `chdir` to the file path.\n\nIf you have issues with long paths, enabling this might help in some scenarios.\n\nDefaults to True (allow changes, backwards compatible) in the 0.10.x versions of AltDSS/DSS C-API. This might change to False in future versions.\n\nThis can also be set through the environment variable DSS_CAPI_ALLOW_CHANGE_DIR. Set it to 0 to disallow changing the active working directory.\n\n**(API Extension)**")]
        HRESULT AllowChangeDir([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a01), propput, helpstring("If disabled, the engine will not change the active working directory during execution. E.g. a `compile` command will not `chdir` to the file path.\n\nIf you have issues with long paths, enabling this might help in some scenarios.\n\nDefaults to True (allow changes, backwards compatible) in the 0.10.x versions of AltDSS/DSS C-API. This might change to False in future versions.\n\nThis can also be set through the environment variable DSS_CAPI_ALLOW_CHANGE_DIR. Set it to 0 to disallow changing the active working directory.\n\n**(API Extension)**")]
        HRESULT AllowChangeDir([in] VARIANT_BOOL Value);
        [id(0x00000a02), propget, helpstring("Only affects the AltDSS engine. If enabled, the `DOScmd` command is allowed. Otherwise, an error is reported if the user tries to use it.\nDefaults to False/0 (disabled state). Users should consider DOScmd deprecated on DSS-Extensions.\nThis can also be set through the environment variable DSS_CAPI_ALLOW_DOSCMD. Setting it to 1 enables the command.\n**(API Extension)**")]
        HRESULT AllowDOScmd([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a02), propput, helpstring("Only affects the AltDSS engine. If enabled, the `DOScmd` command is allowed. Otherwise, an error is reported if the user tries to use it.\nDefaults to False/0 (disabled state). Users should consider DOScmd deprecated on DSS-Extensions.\nThis can also be set through the environment variable DSS_CAPI_ALLOW_DOSCMD. Setting it to 1 enables the command.\n**(API Extension)**")]
        HRESULT AllowDOScmd([in] VARIANT_BOOL Value);
        [id(0x00000a03), propget, helpstring("Only affects AltDSS engines. Gets/sets whether running the external editor for `Show` is allowed\nAllowEditor controls whether the external editor is used in commands like `Show`. If you set to 0 (false), the editor is not executed. Note that other side effects, such as the creation of files, are not affected.\n**(API Extension)**")]
        HRESULT AllowEditor([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a03), propput, helpstring("Only affects AltDSS engines. Gets/sets whether running the external editor for `Show` is allowed\nAllowEditor controls whether the external editor is used in commands like `Show`. If you set to 0 (false), the editor is not executed. Note that other side effects, such as the creation of files, are not affected.\n**(API Extension)**")]
        HRESULT AllowEditor([in] VARIANT_BOOL Value);
        [id(0x00000a04), propget, helpstring("If enabled, in case of errors or empty arrays, the API returns arrays with values compatible with EPRI's OpenDSS COM interface.\nFor example, consider the property `Loads.ZIPV`. If there is no active circuit or active load element:\n- In the disabled state (COMErrorResults=False), the function will return \"[]\", an array with 0 elements.\n- In the enabled state (COMErrorResults=True), the function will return \"[0.0]\" instead. This should be compatible with the return value of the EPRI's OpenDSS COM interface.\n\nDefaults to False/0 (disabled state), starting DSS-Python v0.16.\n\nThis can also be set through the environment variable `DSS_CAPI_COM_DEFAULTS`. Setting it to 0 disables the legacy/COM behavior. The value can be toggled through the API at any time.\n**(API Extension)**")]
        HRESULT COMErrorResults([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a04), propput, helpstring("If enabled, in case of errors or empty arrays, the API returns arrays with values compatible with EPRI's OpenDSS COM interface.\nFor example, consider the property `Loads.ZIPV`. If there is no active circuit or active load element:\n- In the disabled state (COMErrorResults=False), the function will return \"[]\", an array with 0 elements.\n- In the enabled state (COMErrorResults=True), the function will return \"[0.0]\" instead. This should be compatible with the return value of the EPRI's OpenDSS COM interface.\n\nDefaults to False/0 (disabled state), starting DSS-Python v0.16.\n\nThis can also be set through the environment variable `DSS_CAPI_COM_DEFAULTS`. Setting it to 0 disables the legacy/COM behavior. The value can be toggled through the API at any time.\n**(API Extension)**")]
        HRESULT COMErrorResults([in] VARIANT_BOOL Value);
        [id(0x00000a05), propget, helpstring("Controls some compatibility flags introduced to toggle some behavior from EPRI's OpenDSS.\n\n**THE FLAGS ARE GLOBAL, affecting all AltDSS engines in the process.**\nCompatFlags for Oddie-loaded instances (EPRI's OpenDSS and OpenDSS-C engines) are handled by the Oddie code itself,\nso it is global for each Oddie library.\n\nThese flags may change for each version of DSS C-API, but the same value will not be reused. That is,\nwhen we remove a compatibility flag, it will have no effect but will also not affect anything else\nbesides raising an error if the user tries to toggle a flag that was available in a previous version.\n\nWe expect to keep a very limited number of flags. Since the flags are more transient than the other\noptions/flags, it was preferred to add this generic function instead of a separate function per\nflag.\n\nSee the enumeration `DSSCompatFlags` for available flags.\n\n**(API Extension)**")]
        HRESULT CompatFlags([out, retval] long* Value);
        [id(0x00000a05), propput, helpstring("Controls some compatibility flags introduced to toggle some behavior from EPRI's OpenDSS.\n\n**THE FLAGS ARE GLOBAL, affecting all AltDSS engines in the process.**\nCompatFlags for Oddie-loaded instances (EPRI's OpenDSS and OpenDSS-C engines) are handled by the Oddie code itself,\nso it is global for each Oddie library.\n\nThese flags may change for each version of DSS C-API, but the same value will not be reused. That is,\nwhen we remove a compatibility flag, it will have no effect but will also not affect anything else\nbesides raising an error if the user tries to toggle a flag that was available in a previous version.\n\nWe expect to keep a very limited number of flags. Since the flags are more transient than the other\noptions/flags, it was preferred to add this generic function instead of a separate function per\nflag.\n\nSee the enumeration `DSSCompatFlags` for available flags.\n\n**(API Extension)**")]
        HRESULT CompatFlags([in] long Value);
        [id(0x00000a06), propget, helpstring("Controls whether `First`/`Next` iteration includes or skips disabled circuit elements.\nThe default behavior from OpenDSS is to skip those. The user can still activate the element by name or index.\n\nThe default value for IterateDisabled is 0, keeping the original behavior.\nSet it to 1 (or `True`) to include disabled elements.\nOther numeric values are reserved for other potential behaviors.\n**(API Extension)**")]
        HRESULT IterateDisabled([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a06), propput, helpstring("Controls whether `First`/`Next` iteration includes or skips disabled circuit elements.\nThe default behavior from OpenDSS is to skip those. The user can still activate the element by name or index.\n\nThe default value for IterateDisabled is 0, keeping the original behavior.\nSet it to 1 (or `True`) to include disabled elements.\nOther numeric values are reserved for other potential behaviors.\n**(API Extension)**")]
        HRESULT IterateDisabled([in] VARIANT_BOOL Value);
        [id(0x00000a07), propget, helpstring("Controls whether the terminals are checked when updating the currents in Load component. Defaults to True. If the loads are guaranteed to have their terminals closed throughout the simulation, this can be set to False to save some time. **(API Extension)**")]
        HRESULT LoadsTerminalCheck([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a07), propput, helpstring("Controls whether the terminals are checked when updating the currents in Load component. Defaults to True. If the loads are guaranteed to have their terminals closed throughout the simulation, this can be set to False to save some time. **(API Extension)**")]
        HRESULT LoadsTerminalCheck([in] VARIANT_BOOL Value);
        [id(0x00000a08), helpstring("Switch the property names according to the target style. Use this method for compatibility with code that doesn't consider that OpenDSS is case insensitive. Check the enumeration `DSSPropertyNameStyle` for more. **(API Extension)**")]
        HRESULT SetPropertyNameStyle([in] DSSPropertyNameStyle Value);
        [id(0x00000a09), propget, helpstring("Regular expression pattern to skip files.\n\nIf a file name as provided in the input for the `Redirect` and `Compile` commands\nmatches the regular expression pattern, it is skipped (the file is not read nor\ncommands contained in the file are executed).\n\nSet to an empty string to reset/disable the filter.\n\nCase-insensitive.\nSee https://regex.sorokin.engineer/en/latest/regular_expressions.html for information on\nthe expression syntax and options.\n\nEven if the `clear` command is included in `Settings.SkipCommands`, the `DSS.ClearAll()` method can\nstill be called. It resets both skip settings, `SkipCommands` and `SkipFileRegExp`.\n\n**(API Extension)**")]
        HRESULT SkipFileRegExp([out, retval] BSTR* Value);
        [id(0x00000a09), propput, helpstring("Regular expression pattern to skip files.\n\nIf a file name as provided in the input for the `Redirect` and `Compile` commands\nmatches the regular expression pattern, it is skipped (the file is not read nor\ncommands contained in the file are executed).\n\nSet to an empty string to reset/disable the filter.\n\nCase-insensitive.\nSee https://regex.sorokin.engineer/en/latest/regular_expressions.html for information on\nthe expression syntax and options.\n\nEven if the `clear` command is included in `Settings.SkipCommands`, the `DSS.ClearAll()` method can\nstill be called. It resets both skip settings, `SkipCommands` and `SkipFileRegExp`.\n\n**(API Extension)**")]
        HRESULT SkipFileRegExp([in] BSTR Value);
        [id(0x00000a0a), propget, helpstring("Variant array of strings. List of commands to skip\n\nList of strings representing the command names to skip when processing DSS text commands or files.\n\nIf the `clear` command is included in `Settings.SkipCommands`, the `DSS.ClearAll()` method can\nstill be called and it will reset both skip settings, `SkipCommands` and `SkipFileRegExp`.\n\n**(API Extension)**")] // AltDSS element type: BSTR
        HRESULT SkipCommands([out, retval] VARIANT* Value);
        [id(0x00000a0a), propput, helpstring("Variant array of strings. List of commands to skip\n\nList of strings representing the command names to skip when processing DSS text commands or files.\n\nIf the `clear` command is included in `Settings.SkipCommands`, the `DSS.ClearAll()` method can\nstill be called and it will reset both skip settings, `SkipCommands` and `SkipFileRegExp`.\n\n**(API Extension)**")] // AltDSS element type: BSTR
        HRESULT SkipCommands([in] VARIANT Value);
    };

