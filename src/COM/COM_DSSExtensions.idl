        HRESULT NextParam([out, retval] BSTR* Value);
        [id(0x000000cb), propget, helpstring("Default is FALSE. If TRUE parser automatically advances to next token after DblValue, IntValue, or StrValue. Simpler when you don't need to check for parameter names.")]
        HRESULT AutoIncrement([out, retval] VARIANT_BOOL* Value);
        [id(0x000000cb), propput, helpstring("Default is FALSE. If TRUE parser automatically advances to next token after DblValue, IntValue, or StrValue. Simpler when you don't need to check for parameter names.")]
        HRESULT AutoIncrement([in] VARIANT_BOOL Value);
        [id(0x000000cc), propget, helpstring("Return next parameter as a double.")]
        HRESULT DblValue([out, retval] double* Value);
        [id(0x000000cd), propget, helpstring("Return next parameter as a long integer.")]
        HRESULT IntValue([out, retval] long* Value);
        [id(0x000000ce), propget, helpstring("Return next parameter as a string")]
        HRESULT StrValue([out, retval] BSTR* Value);
        [id(0x000000cf), propget, helpstring("Get the characters used for White space in the command string.  Default is blank and Tab.")]
        HRESULT WhiteSpace([out, retval] BSTR* Value);
        [id(0x000000cf), propput, helpstring("Get the characters used for White space in the command string.  Default is blank and Tab.")]
        HRESULT WhiteSpace([in] BSTR Value);
        [id(0x000000d0), propget, helpstring("Get String containing the the characters for Quoting in OpenDSS scripts. Matching pairs defined in EndQuote. Default is \"'([{.")]
        HRESULT BeginQuote([out, retval] BSTR* Value);
        [id(0x000000d0), propput, helpstring("Get String containing the the characters for Quoting in OpenDSS scripts. Matching pairs defined in EndQuote. Default is \"'([{.")]
        HRESULT BeginQuote([in] BSTR Value);
        [id(0x000000d1), propget, helpstring("String containing characters, in order, that match the beginning quote characters in BeginQuote. Default is \"')]}")]
        HRESULT EndQuote([out, retval] BSTR* Value);
        [id(0x000000d1), propput, helpstring("String containing characters, in order, that match the beginning quote characters in BeginQuote. Default is \"')]}")]
        HRESULT EndQuote([in] BSTR Value);
        [id(0x000000d2), propget, helpstring("String defining hard delimiters used to separate token on the command string. Default is , and =. The = separates token name from token value. These override whitesspace to separate tokens.")]
        HRESULT Delimiters([out, retval] BSTR* Value);
        [id(0x000000d2), propput, helpstring("String defining hard delimiters used to separate token on the command string. Default is , and =. The = separates token name from token value. These override whitesspace to separate tokens.")]
        HRESULT Delimiters([in] BSTR Value);
        [id(0x000000d3), helpstring("Reset delimiters to their default values.")]
        HRESULT ResetDelimiters();
        [id(0x000000d4), propget, helpstring("Returns token as variant array of doubles. For parsing quoted array syntax.")]
        HRESULT Vector([in] long ExpectedSize, [out, retval] VARIANT* Value);
        [id(0x000000d5), propget, helpstring("Use this property to parse a Matrix token in OpenDSS format.  Returns square matrix of order specified. Order same as default Fortran order: column by column.")]
        HRESULT Matrix([in] long ExpectedOrder, [out, retval] VARIANT* Value);
        [id(0x000000d6), propget, helpstring("Use this property to parse a matrix token specified in lower triangle form. Symmetry is forced.")]
        HRESULT SymMatrix([in] long ExpectedOrder, [out, retval] VARIANT* Value);
