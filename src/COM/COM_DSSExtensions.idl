    [
        odl,
        uuid(C924B364-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for DSSMain Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface IDSS : IDispatch {
        [id(0x00000001), propget, helpstring("Number of Circuits currently defined")]
        HRESULT NumCircuits([out, retval] long* Value);
        [id(0x00000002), propget, helpstring("Collection of Circuit objects")]
        HRESULT Circuits([in] VARIANT idx, [out, retval] ICircuit** Value);
        [id(0x00000003), propget, helpstring("Returns interface to the active circuit.")]
        HRESULT ActiveCircuit([out, retval] ICircuit** Value);
        [id(0x00000004), propget, helpstring("Returns the DSS Text (command-result) interface.")]
        HRESULT Text([out, retval] IText** Value);
        [id(0x00000005), propget, helpstring("Returns Error interface.")]
        HRESULT Error([out, retval] IError** Value);
        [id(0x00000006), helpstring("Make a new circuit and return interface to active circuit.")]
        HRESULT NewCircuit([in] BSTR Name, [out, retval] ICircuit** Value);
        [id(0x00000007), helpstring("Clears all circuit definitions.")]
        HRESULT ClearAll();
        [id(0x00000008), helpstring("Shows non-MDI child form of the Main DSS Edit Form")]
        HRESULT ShowPanel();
        [id(0x00000009), helpstring("Validate the user and start the DSS. Returns TRUE if successful.")]
        HRESULT Start([in] long Code, [out, retval] VARIANT_BOOL* Value);
        [id(0x0000000a), propget, helpstring("Get version string for the DSS.")]
        HRESULT Version([out, retval] BSTR* Value);
        [id(0x0000000b), propget, helpstring("Gets interface to the DSS Progress Meter")]
        HRESULT DSSProgress([out, retval] IDSSProgress** Value);
        [id(0x0000000c), propget, helpstring("List of DSS intrinsic classes (names of the classes)")] // AltDSS element type: BSTR
        HRESULT Classes([out, retval] VARIANT* Value);
        [id(0x0000000d), propget, helpstring("List of user-defined classes")] // AltDSS element type: BSTR
        HRESULT UserClasses([out, retval] VARIANT* Value);
        [id(0x0000000e), propget, helpstring("Number of DSS intrinsic classes")]
        HRESULT NumClasses([out, retval] long* Value);
        [id(0x0000000f), propget, helpstring("Number of user-defined classes")]
        HRESULT NumUserClasses([out, retval] long* Value);
        [id(0x00000011), propget, helpstring("DSS Data File Path.  Default path for reports, etc. from DSS")]
        HRESULT DataPath([out, retval] BSTR* Value);
        [id(0x00000011), propput, helpstring("DSS Data File Path.  Default path for reports, etc. from DSS")]
        HRESULT DataPath([in] BSTR Value);
        [id(0x00000012), helpstring("Resets DSS Initialization for restarts, etc from applets")]
        HRESULT Reset();
        [id(0x00000014), propget, helpstring("Default is TRUE. Use this to set to FALSE; Cannot reset to TRUE;")]
        HRESULT AllowForms([out, retval] VARIANT_BOOL* Value);
        [id(0x00000014), propput, helpstring("Default is TRUE. Use this to set to FALSE; Cannot reset to TRUE;")]
        HRESULT AllowForms([in] VARIANT_BOOL Value);
        [id(0x000000c9), propget, helpstring("Returns the path name for the default text editor.")]
        HRESULT DefaultEditor([out, retval] BSTR* Value);
        [id(0x000000ca), propget, helpstring("Returns interface to the active class.")]
        HRESULT ActiveClass([out, retval] IActiveClass** Value);
        [id(0x000000cb), helpstring("Sets the Active DSS Class for use with ActiveClass interface. Same as SetActiveClass in Circuit interface.")]
        HRESULT SetActiveClass([in] BSTR ClassName, [out, retval] long* Value);
        [id(0x000000cd), propget, helpstring("Interface to DSS Executive commands and options")]
        HRESULT Executive([out, retval] IDSS_Executive** Value);
        // [id(0x000000ce), propget, helpstring("Interface to the DSS Events")]
        // HRESULT Events([out, retval] IDSSEvents** Value);
        [id(0x000000cc), propget, helpstring("Returns an interface to the complex math library.")]
        HRESULT CmathLib([out, retval] ICmathLib** Value);
        [id(0x000000cf), propget, helpstring("Returns interface to the OpenDSS Parser library for use by user-written programs.")]
        HRESULT Parser([out, retval] IParser** Value);
        [id(0x000000d0), propget]
        HRESULT DSSim_Coms([out, retval] IDSSimComs** Value);
        
        // Added on DSS-Extensions (API Extensions)
        [id(0x00000a01), propget, helpstring("Connect to ZIP file Interface **(API Extension)**")]
        HRESULT ZIP([out, retval] IZIP** Value);
        [id(0x00000a02), propget, helpstring("Connect to YMatrix Interface **(API Extension)**")]
