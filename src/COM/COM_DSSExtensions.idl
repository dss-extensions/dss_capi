[
    uuid(C924B0F8-18C2-11F0-A417-C87F5452571C),
    version(1.0),
    helpstring("DSS-Extensions COM Bridge for DSS Engines (AltDSS, OpenDSS-C, OpenDSS Delphi)")
]
library DSSExtensions
{
    importlib("stdole2.tlb");

    interface IText;
    interface IDSSProperty;
    interface ICktElement;
    interface IError;
    interface ICircuit;
    interface IBus;
    interface IDSS;
    interface ISolution;
    interface IMonitors;
    interface IMeters;
    interface IGenerators;
    interface IDSSProgress;
    interface ISettings;
    interface ILines;
    interface ICtrlQueue;
    interface ILoads;
    interface IDSSElement;
    interface IActiveClass;
    interface ICapacitors;
    interface ITransformers;
    interface ISwtControls;
    interface ICapControls;
    interface IRegControls;
    interface ITopology;
    interface IDSS_Executive;
    // interface IDSSEvents;
    // dispinterface IDSSEventsEvents;
    interface ISensors;
    interface IXYCurves;
    interface IPDElements;
    interface IReclosers;
    interface IRelays;
    interface ICmathLib;
    interface IParser;
    interface ILoadShapes;
    interface IFuses;
    interface IISources;
    interface IDSSimComs;
    interface IPVSystems;
    interface IVsources;
    interface IParallel;
    interface ILineCodes;
    interface IGICSources;
    interface IReduceCkt;
    interface IStorages;
    interface IWindGens;
    interface IReactors;
    interface IYMatrix;
    interface IZIP;

    typedef [uuid(C924BE2C-18C2-11F0-A417-C87F5452571C), version(1.0), helpstring("Modes for Monitors")]
        enum {
        dssVI = 0,
        dssPower = 1,
        dssSequence = 16,
        dssMagnitude = 32,
        dssPosOnly = 64,
        dssTaps = 2,
        dssStates = 3
    } MonitorModes;

    typedef [uuid(C924BE40-18C2-11F0-A417-C87F5452571C), version(1.0)]
        enum {
        dssSnapShot = 0,
        dssDutyCycle = 6,
        dssDirect = 7,
        dssDaily = 1,
        dssMonte1 = 3,
        dssMonte2 = 10,
        dssMonte3 = 11,
        dssFaultStudy = 9,
        dssYearly = 2,
        dssMonteFault = 8,
        dssPeakDay = 5,
        dssLD1 = 4,
        dssLD2 = 12,
        dssAutoAdd = 13,
        dssHarmonic = 15,
        dssDynamic = 14
    } SolveModes;

    typedef [uuid(C924BE54-18C2-11F0-A417-C87F5452571C), version(1.0)]
        enum {
        dssPowerFlow = 1,
        dssAdmittance = 2,
        dssNormalSolve = 0,
        dssNewtonSolve = 1,
        dssStatic = 0,
        dssEvent = 1,
        dssTime = 2,
        dssMultiphase = 0,
        dssPositiveSeq = 1,
        dssGaussian = 1,
        dssUniform = 2,
        dssLogNormal = 3,
        dssAddGen = 1,
        dssAddCap = 2,
        dssControlOFF = 0xffffffff
    } Options;

    typedef [uuid(C924BE68-18C2-11F0-A417-C87F5452571C), version(1.0)]
        enum {
        dssCapControlVoltage = 1,
        dssCapControlKVAR = 2,
        dssCapControlCurrent = 0,
        dssCapControlPF = 4,
        dssCapControlTime = 3
    } CapControlModes;

    typedef [uuid(C924BE7C-18C2-11F0-A417-C87F5452571C), version(1.0)]
        enum {
        dssActionNone = 0,
        dssActionOpen = 1,
        dssActionClose = 2,
        dssActionReset = 3,
        dssActionLock = 4,
        dssActionUnlock = 5,
        dssActionTapUp = 6,
        dssActionTapDown = 7
    } ActionCodes;

    typedef [uuid(C924BE90-18C2-11F0-A417-C87F5452571C)]
        enum {
        dssLoadVariable = 0,
        dssLoadFixed = 1,
        dssLoadExempt = 2
    } LoadStatus;

    typedef [uuid(C924BEA4-18C2-11F0-A417-C87F5452571C)]
        enum {
        dssLoadConstPQ = 1,
        dssLoadConstZ = 2,
        dssLoadMotor = 3,
        dssLoadCVR = 4,
        dssLoadConstI = 5,
        dssLoadConstPFixedQ = 6,
        dssLoadConstPFixedX = 7,
        dssLoadZIPV = 8
    } LoadModels;

    typedef [uuid(C924BEB8-18C2-11F0-A417-C87F5452571C)]
        enum {
        dssLineUnitsNone = 0,
        dssLineUnitsMiles = 1,
        dssLineUnitskFt = 2,
        dssLineUnitskm = 3,
        dssLineUnitsmeter = 4,
        dssLineUnitsft = 5,
        dssLineUnitsinch = 6,
        dssLineUnitscm = 7,
        dssLineUnitsmm = 8,
        dssLineUnitsMaxnum = 9
    } LineUnits;

    typedef [
        uuid(04968192-1D6A-11F0-BC79-C87F5452571C),
        helpstring("This enum is used in the PropertyNameStyle property to control the naming convention. Currently, this only affects capitalization, i.e., if your software already uses case insensitive string comparisons for the property names, this is not useful. Otherwise, you can use `Legacy` to use the older names. **(API Extension)**")
    ]
        enum {
        dssModernStyle = 0,
        dssLowercaseStyle = 1,
        dssLegacyStyle = 2
    } DSSPropertyNameStyle;

    typedef [
        uuid(8150D456-1D8F-11F0-9029-C87F5452571C),
        helpstring("DSS-Extensions Compatibility (bit) flags; see https://github.com/dss-extensions/dss_capi/blob/master/docs/known_differences.md or doc pages on DSS-Extensions.org for more info, e.g. https://dss-extensions.org/DSS-Python/enumerations.html#dss_python_backend.enums.dss_python_backend.enums.DSSCompatFlags.DSSCompatFlags **(API Extension)**")
    ]
        enum {
        dssCompatNoSolverFloatChecks = 0x00000001,
        dssCompatBadPrecision = 0x00000002,
        dssCompatInvControl9611 = 0x00000004,
        dssCompatSaveCalcVoltageBases = 0x00000008,
        dssCompatActiveLine = 0x00000010,
        dssCompatNoPropertyTracking = 0x00000020,
        dssCompatSkipSideEffects = 0x00000040,
        dssCompatMonitorHeader = 0x00000080,
        dssCompatInvControlDeltaV = 0x00000100,
        dssCompatPermissiveProperties = 0x00000200
    } DSSCompatFlags;

    typedef [
        uuid(3D5FA0C8-1D90-11F0-AF38-C87F5452571C),
        helpstring("DSSSaveFlags are bit flags used in the Circuit.Save function to customize the saved circuit. For some examples, see https://dss-extensions.org/OpenDSSDirect.py/notebooks/Saving.html **(API Extension)**")
    ]
        enum {
        dssSaveCalcVoltageBases = 0x0001,
        dssSaveSetVoltageBases = 0x0002,
        dssSaveIncludeOptions = 0x0004,
        dssSaveIncludeDisabled = 0x0008,
        dssSaveExcludeDefault = 0x0010,
        dssSaveSingleFile = 0x0020,
        dssSaveKeepOrder = 0x0040,
        dssSaveExcludeMeterZones = 0x0080,
        dssSaveIsOpen = 0x0100,
        dssSaveToString = 0x0200
    } DSSSaveFlags;

    typedef [
        uuid(2593AFE6-1D97-11F0-9EE5-C87F5452571C),
        helpstring("DSSJSONFlags are bit flags used in the JSON related functions on DSS-Extensions. For some examples, see https://dss-extensions.org/DSS-Python/examples/JSON.html **(API Extension)**")
    ]
        enum {
        dssJSONFull = 0x00000001,
        dssJSONSkipRedundant = 0x00000002,
        dssJSONEnumAsInt = 0x00000004,
        dssJSONFullNames = 0x00000008,
        dssJSONPretty = 0x00000010,
        dssJSONExcludeDisabled = 0x00000020,
        dssJSONIncludeDSSClass = 0x00000040,
        dssJSONLowercaseKeys = 0x00000080,
        dssJSONIncludeDefaultObjs = 0x00000100,
        dssJSONSkipTimestamp = 0x00000200,
        dssJSONSkipBuses = 0x00000400
    } DSSJSONFlags;

    typedef [
        uuid(2D752EB0-1D97-11F0-9EE5-C87F5452571C),
        helpstring("SparseSolverOptions are flags to control advanced features on AltDSS engine; some features are also being ported to OpenDSS-C when built with our KLUSolveX **(API Extension)**")
    ]
        enum {
        dssSolverReuseNothing = 0,
        dssSolverReuseCompressedMatrix = 1,
        dssSolverReuseSymbolicFactorization = 2,
        dssSolverReuseNumericFactorization = 3,
        dssSolverAlwaysResetYPrimInvalid = 0x10000000
    } SparseSolverOptions;

    [
        odl,
        uuid(C924B15C-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for Text Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface IText : IDispatch {
        [id(0x00000001), propget, helpstring("Input command string for the DSS.")]
        HRESULT Command([out, retval] BSTR* Command);
        [id(0x00000001), propput, helpstring("Input command string for the DSS.")]
        HRESULT Command([in] BSTR Command);
        [id(0x00000002), propget, helpstring("Result string for the last command.")]
        HRESULT Result([out, retval] BSTR* Result);
    };

    [
        uuid(C924B198-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Text Object")
    ]
    coclass Text {
        [default] interface IText;
    };

    [
        odl,
        uuid(C924B1B6-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for DSSProperty Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface IDSSProperty : IDispatch {
        [id(0x00000001), propget, helpstring("Name of Property")]
        HRESULT Name([out, retval] BSTR* Name);
        [id(0x00000003), propget, helpstring("Description of the property.")]
        HRESULT Description([out, retval] BSTR* Description);
        [id(0x00000002), propget]
        HRESULT Val([out, retval] BSTR* Value);
        [id(0x00000002), propput]
        HRESULT Val([in] BSTR Value);
    };

    [
        uuid(C924B1DE-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("DSSProperty Object")
    ]
    coclass DSSProperty {
        [default] interface IDSSProperty;
    };

    [
        odl,
        uuid(C924B206-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for CktElement Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface ICktElement : IDispatch {
        [id(0x00000001), propget, helpstring("Full Name of Active Circuit Element")]
        HRESULT Name([out, retval] BSTR* Value);
        [id(0x00000002), propget, helpstring("Number of Terminals this Circuit Element")]
        HRESULT NumTerminals([out, retval] long* Value);
        [id(0x00000003), propget, helpstring("Number of Conductors per Terminal")]
        HRESULT NumConductors([out, retval] long* Value);
        [id(0x00000004), propget, helpstring("Number of Phases")]
        HRESULT NumPhases([out, retval] long* Value);
        [id(0x00000005), propget, helpstring("Variant array of strings. Get  Bus definitions to which each terminal is connected. 0-based array.")] // AltDSS element type: BSTR
        HRESULT BusNames([out, retval] VARIANT* Value);
        [id(0x00000005), propput, helpstring("Variant array of strings. Get  Bus definitions to which each terminal is connected. 0-based array.")] // AltDSS element type: BSTR
        HRESULT BusNames([in] VARIANT Value);
        [id(0x00000006), propget, helpstring("Collection of Properties for this Circuit Element (0 based index, if numeric)")]
        HRESULT Properties([in] VARIANT Indx, [out, retval] IDSSProperty** Value);
        [id(0x00000007), propget, helpstring("Complex array of voltages at terminals")]
        HRESULT Voltages([out, retval] VARIANT* Value);
        [id(0x00000008), propget, helpstring("Complex array of currents into each conductor of each terminal")]
        HRESULT Currents([out, retval] VARIANT* Value);
        [id(0x00000009), propget, helpstring("Complex array of powers into each conductor of each terminal")]
        HRESULT Powers([out, retval] VARIANT* Value);
        [id(0x0000000a), propget, helpstring("Total losses in the element: two-element complex array")]
        HRESULT Losses([out, retval] VARIANT* Value);
        [id(0x0000000b), propget, helpstring("Complex array of losses by phase")]
        HRESULT PhaseLosses([out, retval] VARIANT* Value);
        [id(0x0000000c), propget, helpstring("Double array of symmetrical component voltages at each 3-phase terminal")]
        HRESULT SeqVoltages([out, retval] VARIANT* Value);
        [id(0x0000000d), propget, helpstring("Double array of symmetrical component currents into each 3-phase terminal")]
        HRESULT SeqCurrents([out, retval] VARIANT* Value);
        [id(0x0000000e), propget, helpstring("Double array of sequence powers into each 3-phase terminal")]
        HRESULT SeqPowers([out, retval] VARIANT* Value);
        [id(0x0000000f), propget, helpstring("Boolean indicating that element is currently in the circuit.")]
        HRESULT Enabled([out, retval] VARIANT_BOOL* Value);
        [id(0x0000000f), propput, helpstring("Boolean indicating that element is currently in the circuit.")]
        HRESULT Enabled([in] VARIANT_BOOL Value);
        [id(0x00000010), propget, helpstring("Normal ampere rating for PD Elements")]
        HRESULT NormalAmps([out, retval] double* Value);
        [id(0x00000010), propput, helpstring("Normal ampere rating for PD Elements")]
        HRESULT NormalAmps([in] double Value);
        [id(0x00000011), propget, helpstring("Emergency Ampere Rating for PD elements")]
        HRESULT EmergAmps([out, retval] double* Value);
        [id(0x00000011), propput, helpstring("Emergency Ampere Rating for PD elements")]
        HRESULT EmergAmps([in] double Value);
        [id(0x00000012), helpstring("Open the specified terminal and phase, if non-zero.  Else all conductors at terminal.")]
        HRESULT Open([in] long Term, [in] long Phs);
        [id(0x00000013), helpstring("Close the specified terminal and phase, if non-zero.  Else all conductors at terminal.")]
        HRESULT Close([in] long Term, [in] long Phs);
        [id(0x00000014), helpstring("Boolean indicating if the specified terminal and, optionally, phase is open.")]
        HRESULT IsOpen([in] long Term, [in] long Phs, [out, retval] VARIANT_BOOL* Value);
        [id(0x00000015), propget, helpstring("Number of Properties this Circuit Element.")]
        HRESULT NumProperties([out, retval] long* Value);
        [id(0x00000016), propget, helpstring("Variant array containing all property names of the active device.")] // AltDSS element type: BSTR
        HRESULT AllPropertyNames([out, retval] VARIANT* Value);
        [id(0x00000017), propget, helpstring("Residual currents for each terminal: (mag, angle)")]
        HRESULT Residuals([out, retval] VARIANT* Value);
        [id(0x00000018), propget, helpstring("YPrim matrix, column order, complex numbers (paired)")]
        HRESULT Yprim([out, retval] VARIANT* Value);
        [id(0x000000c9), propget, helpstring("Display name of the object (not necessarily unique)")]
        HRESULT DisplayName([out, retval] BSTR* Value);
        [id(0x000000c9), propput, helpstring("Display name of the object (not necessarily unique)")]
        HRESULT DisplayName([in] BSTR Value);
        [id(0x000000ca), propget, helpstring("Pointer to this object")]
        HRESULT Handle([out, retval] long* Value);
        [id(0x000000cb), propget, helpstring("globally unique identifier for this object")]
        HRESULT GUID([out, retval] BSTR* Value);
        [id(0x000000cc), propget, helpstring("This element has a SwtControl attached.")]
        HRESULT HasSwitchControl([out, retval] VARIANT_BOOL* Value);
        [id(0x000000cd), propget, helpstring("This element has a CapControl or RegControl attached.")]
        HRESULT HasVoltControl([out, retval] VARIANT_BOOL* Value);
        [id(0x000000ce), propget, helpstring("Name of the Energy Meter this element is assigned to.")]
        HRESULT EnergyMeter([out, retval] BSTR* Value);
        [id(0x000000cf), propget, helpstring("Full name of the i-th controller attached to this element. Ex: str = Controller(2).  See NumControls to determine valid index range")]
        HRESULT Controller([in] long idx, [out, retval] BSTR* Value);
        [id(0x000000d0), propget, helpstring("Complex double array of Sequence Voltage for all terminals of active circuit element.")]
        HRESULT CplxSeqVoltages([out, retval] VARIANT* Value);
        [id(0x000000d1), propget, helpstring("Complex double array of Sequence Currents for all conductors of all terminals of active circuit element.")]
        HRESULT CplxSeqCurrents([out, retval] VARIANT* Value);
        [id(0x000000d2), propget, helpstring("Variant array of strings listing all the published variable names, if a PCElement. Otherwise, null string.")] // AltDSS element type: BSTR
        HRESULT AllVariableNames([out, retval] VARIANT* Value);
        [id(0x000000d3), propget, helpstring("Variant array of doubles. Values of state variables of active element if PC element.")]
        HRESULT AllVariableValues([out, retval] VARIANT* Value);
        [id(0x000000d4), propget, helpstring("For PCElement, get the value of a variable by name. If Code>0 Then no variable by this name or not a PCelement.")]
        HRESULT Variable([in] BSTR MyVarName, [out] long* Code, [out, retval] double* Value);
        [id(0x000000d5), propget, helpstring("For PCElement, get the value of a variable by integer index.")]
        HRESULT Variablei([in] long idx, [out] long* Code, [out, retval] double* Value);
        [id(0x000000d6), propget, helpstring("Variant array of integer containing the node numbers (representing phases, for example) for each conductor of each terminal. ")] // AltDSS element type: int32
        HRESULT NodeOrder([out, retval] VARIANT* Value);
        [id(0x000000d7), propget, helpstring("True if a recloser, relay, or fuse controlling this ckt element. OCP = Overcurrent Protection ")]
        HRESULT HasOCPDevice([out, retval] VARIANT_BOOL* Value);
        [id(0x000000d8), propget, helpstring("Number of controls connected to this device. Use to determine valid range for index into Controller array.")]
        HRESULT NumControls([out, retval] long* Value);
        [id(0x000000d9), propget, helpstring("Index into Controller list of OCP Device controlling this CktElement")]
        HRESULT OCPDevIndex([out, retval] long* Value);
        [id(0x000000da), propget, helpstring("0=None; 1=Fuse; 2=Recloser; 3=Relay;  Type of OCP controller device")]
        HRESULT OCPDevType([out, retval] long* Value);
        [id(0x000000db), propget, helpstring("Currents in magnitude, angle format as a variant array of doubles.")]
        HRESULT CurrentsMagAng([out, retval] VARIANT* Value);
        [id(0x000000dc), propget, helpstring("Voltages at each conductor in magnitude, angle form as variant array of doubles.")]
        HRESULT VoltagesMagAng([out, retval] VARIANT* Value);
        [id(0x000000dd), propget, helpstring("Returns the total powers (complex) at ALL terminals of the active circuit element.")]
        HRESULT TotalPowers([out, retval] VARIANT* Value);
        [id(0x000000de), propget, helpstring("For PCElement, get the value of a variable by name. If Code>0 Then no variable by this name or not a PCelement.")]
        HRESULT VariableByName([in] BSTR MyVarName, [out] long* Code, [out, retval] double* Value);
        [id(0x000000de), propput, helpstring("For PCElement, get the value of a variable by name. If Code>0 Then no variable by this name or not a PCelement.")]
        HRESULT VariableByName([in] BSTR MyVarName, [out] long* Code, [in] double Value);
        [id(0x000000df), propget, helpstring("For PCElement, get the value of a variable by Index. If Code>0 Then no variable by this name or not a PCelement.")]
        HRESULT VariableByIndex([in] long idx, [out] long* Code, [out, retval] double* Value);
        [id(0x000000df), propput, helpstring("For PCElement, get the value of a variable by Index. If Code>0 Then no variable by this name or not a PCelement.")]
        HRESULT VariableByIndex([in] long idx, [out] long* Code, [in] double Value);
        [id(0x000000e0), propget, helpstring("Gets the name of the active state variable if any, otherwise, returns and empty string")]
        HRESULT VariableName([out, retval] BSTR* Value);
        [id(0x000000e0), propput, helpstring("Gets the name of the active state variable if any, otherwise, returns and empty string")]
        HRESULT VariableName([in] BSTR Value);
        [id(0x000000e1), propget, helpstring("Gets the  present value for the active state variable. If there no active variable, returns a error message.")]
        HRESULT VariableValue([out, retval] double* Value);
        [id(0x000000e1), propput, helpstring("Gets the  present value for the active state variable. If there no active variable, returns a error message.")]
        HRESULT VariableValue([in] double Value);
        [id(0x000000e2), propget, helpstring("Gets the index of the active state variable if any, otherwise, returns -1")]
        HRESULT VariableIdx([out, retval] long* Value);
        [id(0x000000e2), propput, helpstring("Gets the index of the active state variable if any, otherwise, returns -1")]
        HRESULT VariableIdx([in] long Value);
        [id(0x000000e3), propget, helpstring("Complex array with the losses by type (total losses, load losses, no-load losses), in VA, for the active circuit element.\nAdded in May 2025. Same as `LossesByType` introduced for Transformers in AltDSS/DSS C-API in May 2019.")]
        HRESULT AllLosses([out, retval] VARIANT* Value);

        // Added on DSS-Extensions (API Extensions)
        [id(0x00000a01), propget, helpstring("Returns true if the current active element is isolated. Note that this only fetches the current value. See also the Topology interface. **(API Extension)**.")]
        HRESULT IsIsolated([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a02), propget, helpstring("Array of integers, a copy of the internal NodeRef of the CktElement. Be sure to run a solution to initialize the values after the circuit is created or modified. **(API Extension)**")] // AltDSS element type: int32
        HRESULT NodeRef([out, retval] VARIANT* Nodes);
    };

    [
        uuid(C924B242-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("CktElement Object")
    ]
    coclass CktElement {
        [default] interface ICktElement;
    };

    [
        odl,
        uuid(C924B26A-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for Error Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface IError : IDispatch {
        [id(0x00000001), propget, helpstring("Error Number")]
        HRESULT Number([out, retval] long* Number);
        [id(0x00000002), propget, helpstring("Description of error for last operation")]
        HRESULT Description([out, retval] BSTR* Description);

        // Added on DSS-Extensions (API Extensions)
        [id(0x00000a01), propget, helpstring("EarlyAbort controls whether all errors halts the DSS script processing (Compile/Redirect), defaults to True. **(API Extension)**")]
        HRESULT EarlyAbort([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a01), propput, helpstring("EarlyAbort controls whether all errors halts the DSS script processing (Compile/Redirect), defaults to True. **(API Extension)**")]
        HRESULT EarlyAbort([in] VARIANT_BOOL Value);
        [id(0x00000a02), propget, helpstring("Specifies whether the DSS errors are automatically translated into corresponding COM errors/exceptions. **(API Extension)**")]
        HRESULT UseExceptions([out, retval] VARIANT_BOOL* Value);
        [id(0x00000a02), propput, helpstring("Specifies whether the DSS errors are automatically translated into corresponding COM errors/exceptions. **(API Extension)**")]
        HRESULT UseExceptions([in] VARIANT_BOOL Value);
    };

    [
        uuid(C924B27E-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Error Object")
    ]
    coclass Error {
        [default] interface IError;
    };

    [
        odl,
        uuid(C924B2BA-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for Circuit Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface ICircuit : IDispatch {
        [id(0x00000001), propget, helpstring("Name of the active circuit.")]
        HRESULT Name([out, retval] BSTR* Value);
        [id(0x00000002), propget, helpstring("Number of CktElements in the circuit.")]
        HRESULT NumCktElements([out, retval] long* Value);
        [id(0x00000003), propget, helpstring("Total number of Buses in the circuit.")]
        HRESULT NumBuses([out, retval] long* Value);
        [id(0x00000004), propget, helpstring("Total number of nodes in the circuit.")]
        HRESULT NumNodes([out, retval] long* Value);
        [id(0x00000005), propget, helpstring("Collection of Buses in the circuit. Index may be string or integer index (0 based).")]
        HRESULT Buses([in] VARIANT Index, [out, retval] IBus** Value);
        [id(0x00000006), propget, helpstring("Collection of CktElements in Circuit")]
        HRESULT CktElements([in] VARIANT idx, [out, retval] ICktElement** Value);
        [id(0x00000007), propget, helpstring("Total losses in active circuit, complex number (two-element array of double).")]
        HRESULT Losses([out, retval] VARIANT* Value);
        [id(0x00000008), propget, helpstring("Complex total line losses in the circuit")]
        HRESULT LineLosses([out, retval] VARIANT* Value);
        [id(0x00000009), propget, helpstring("Complex losses in all transformers designated to substations.")]
        HRESULT SubstationLosses([out, retval] VARIANT* Value);
        [id(0x0000000a), propget, helpstring("Total power, watts delivered to the circuit")]
        HRESULT TotalPower([out, retval] VARIANT* Value);
        [id(0x0000000b), propget, helpstring("Complex array of all bus, node voltages from most recent solution")]
        HRESULT AllBusVolts([out, retval] VARIANT* Value);
        [id(0x0000000c), propget, helpstring("Array of magnitudes (doubles) of voltages at all buses")]
        HRESULT AllBusVmag([out, retval] VARIANT* Value);
        [id(0x0000000d), propget, helpstring("Variant array of strings containing Full Name of all elements.")] // AltDSS element type: BSTR
        HRESULT AllElementNames([out, retval] VARIANT* Value);
        [id(0x0000000e), propget, helpstring("Return an interface to the active circuit element")]
        HRESULT ActiveElement([out, retval] ICktElement** Value);
        [id(0x0000000f), helpstring("Disable a circuit element by name (removes from circuit but leave in database)")]
        HRESULT Disable([in] BSTR myName);
        [id(0x00000010), helpstring("Activate (enable) a disabled device.")]
        HRESULT Enable([in] BSTR myName);
        [id(0x00000011), propget, helpstring("Return an interface to the Solution object.")]
        HRESULT Solution([out, retval] ISolution** Value);
        [id(0x00000012), propget, helpstring("Return an interface to the active bus.")]
        HRESULT ActiveBus([out, retval] IBus** Value);
        [id(0x00000013), helpstring("Sets the first Power Conversion (PC) element to be the active element.")]
        HRESULT FirstPCElement([out, retval] long* Value);
        [id(0x00000014), helpstring("Gets next PC Element.  Returns 0 if no more.")]
        HRESULT NextPCElement([out, retval] long* Value);
        [id(0x00000015), helpstring("Sets the first Power Delivery (PD) element to be the active element.")]
        HRESULT FirstPDElement([out, retval] long* Value);
        [id(0x00000016), helpstring("Gets next PD Element. Returns 0 if no more.")]
        HRESULT NextPDElement([out, retval] long* Value);
        [id(0x00000017), propget, helpstring("Array of strings containing names of all buses in circuit (see AllNodeNames).")] // AltDSS element type: BSTR
        HRESULT AllBusNames([out, retval] VARIANT* Value);
        [id(0x00000018), propget, helpstring("Array of total losses (complex) in each circuit element")]
        HRESULT AllElementLosses([out, retval] VARIANT* Value);
        [id(0x00000019), helpstring("Force all Meters and Monitors to take a sample.")]
        HRESULT Sample();
        [id(0x0000001a), helpstring("Force all meters and monitors to save their current buffers.")]
        HRESULT SaveSample();
        [id(0x0000001b), propget, helpstring("Returns interface to Monitors collection.")]
        HRESULT Monitors([out, retval] IMonitors** Value);
        [id(0x0000001c), propget, helpstring("Returns interface to Meters (EnergyMeter) collection.")]
        HRESULT Meters([out, retval] IMeters** Value);
        [id(0x0000001d), propget, helpstring("Returns a Generators Object interface")]
        HRESULT Generators([out, retval] IGenerators** Value);
        [id(0x0000001e), propget, helpstring("Returns interface to Settings interface.")]
        HRESULT Settings([out, retval] ISettings** Value);
        [id(0x0000001f), propget, helpstring("Returns Interface to Lines collection.")]
        HRESULT Lines([out, retval] ILines** Value);
        [id(0x00000020), helpstring("Sets the Active Circuit Element using the full object name (e.g. \"generator.g1\"). Returns -1 if not found. Else index to be used in CktElements collection or AllElementNames.")]
        HRESULT SetActiveElement([in] BSTR FullName, [out, retval] long* Value);
        [id(0x00000021)]
        HRESULT Capacity([in] double Start, [in] double Increment, [out, retval] double* Value);
        [id(0x00000022), helpstring("Sets Active bus by name. Ignores node list.  Returns bus index (zero based) compatible with AllBusNames and Buses collection.")]
        HRESULT SetActiveBus([in] BSTR BusName, [out, retval] long* Value);
        [id(0x00000024), helpstring("Sets ActiveBus by Integer value.  0-based index compatible with SetActiveBus return value and AllBusNames indexing. Returns 0 if OK.")]
        HRESULT SetActiveBusi([in] long BusIndex, [out, retval] long* Value);
        [id(0x00000023), propget, helpstring("Double Array of all bus voltages (each node) magnitudes in Per unit")]
        HRESULT AllBusVmagPu([out, retval] VARIANT* Value);
        [id(0x00000025), propget, helpstring("Variant array of strings containing full name of each node in system in same order as returned by AllBusVolts, etc.")] // AltDSS element type: BSTR
        HRESULT AllNodeNames([out, retval] VARIANT* Value);
        [id(0x00000026), propget, helpstring("System Y matrix (after a solution has been performed)")]
        HRESULT SystemY([out, retval] VARIANT* Value);
        [id(0x000000c9), propget, helpstring("Interface to the main Control Queue")]
        HRESULT CtrlQueue([out, retval] ICtrlQueue** Value);
        [id(0x000000ca), propget, helpstring("Returns distance from each bus to parent EnergyMeter. Corresponds to sequence in AllBusNames.")]
        HRESULT AllBusDistances([out, retval] VARIANT* Value);
        [id(0x000000cb), propget, helpstring("Returns an array of distances from parent EnergyMeter for each Node. Corresponds to AllBusVMag sequence.")]
        HRESULT AllNodeDistances([out, retval] VARIANT* Value);
        [id(0x000000cc), propget, helpstring("Returns Array of doubles represent voltage magnitudes for nodes on the specified phase.")]
        HRESULT AllNodeVmagByPhase([in] long Phase, [out, retval] VARIANT* Value);
        [id(0x000000cd), propget, helpstring("Returns array of per unit voltage magnitudes for each node by phase")]
        HRESULT AllNodeVmagPUByPhase([in] long Phase, [out, retval] VARIANT* Value);
        [id(0x000000ce), propget, helpstring("Returns an array of doubles representing the distances to parent EnergyMeter. Sequence of array corresponds to other node ByPhase properties.")]
        HRESULT AllNodeDistancesByPhase([in] long Phase, [out, retval] VARIANT* Value);
        [id(0x000000cf), propget, helpstring("Return variant array of strings of the node names for the By Phase criteria. Sequence corresponds to other ByPhase properties.")] // AltDSS element type: BSTR
        HRESULT AllNodeNamesByPhase([in] long Phase, [out, retval] VARIANT* Value);
        [id(0x000000d0), propget, helpstring("Returns interface to Load element interface")]
        HRESULT Loads([out, retval] ILoads** Value);
        [id(0x000000d1), helpstring("Sets First element of active class to be the Active element in the active circuit. Returns 0 if none.")]
        HRESULT FirstElement([out, retval] long* Value);
        [id(0x000000d2), helpstring("Sets the next element of the active class to be the active element in the active circuit. Returns 0 if no more elements.")]
        HRESULT NextElement([out, retval] long* Value);
        [id(0x000000d3), helpstring("Sets the active class by name.  Use FirstElement, NextElement to iterate through the class. Returns -1 if fails.")]
        HRESULT SetActiveClass([in] BSTR ClassName, [out, retval] long* Value);
        [id(0x000000d4), propget, helpstring("Returns Interface to the Active DSS object, which could be either a circuit element or a general DSS element.")]
        HRESULT ActiveDSSElement([out, retval] IDSSElement** Value);
        [id(0x000000d5), propget, helpstring("Returns interface to the Active Circuit element (same as ActiveElement).")]
        HRESULT ActiveCktElement([out, retval] ICktElement** Value);
        [id(0x000000d6), propget, helpstring("Returns interface to active class.")]
        HRESULT ActiveClass([out, retval] IActiveClass** Value);
        [id(0x000000d7), propget, helpstring("Returns interface to Transformers collection")]
        HRESULT Transformers([out, retval] ITransformers** Value);
        [id(0x000000d8), propget, helpstring("Returns interface to SwtControls collection.")]
        HRESULT SwtControls([out, retval] ISwtControls** Value);
        [id(0x000000d9), propget, helpstring("Returns interface to CapControls collection")]
        HRESULT CapControls([out, retval] ICapControls** Value);
        [id(0x000000da), propget, helpstring("Returns interface to RegControls collection")]
        HRESULT RegControls([out, retval] IRegControls** Value);
        [id(0x000000db), propget, helpstring("Interface to the active circuit's Capacitors collection.")]
        HRESULT Capacitors([out, retval] ICapacitors** Value);
        [id(0x000000dc), propget, helpstring("Interface to the active circuit's topology object.")]
        HRESULT Topology([out, retval] ITopology** Value);
        [id(0x000000dd), propget, helpstring("Interface to Sensors in the Active Circuit.")]
        HRESULT Sensors([out, retval] ISensors** Value);
        [id(0x000000de), helpstring("Forces update to all storage classes. Typically done after a solution. Done automatically in intrinsic solution modes.")]
        HRESULT UpdateStorage();
        [id(0x000000df), propget, helpstring("Sets Parent PD element, if any, to be the active circuit element and returns index>0; Returns 0 if it fails or not applicable.")]
        HRESULT ParentPDElement([out, retval] long* Value);
        [id(0x000000e0), propget, helpstring("Interface to XYCurves in active circuit.")]
        HRESULT XYCurves([out, retval] IXYCurves** Value);
        [id(0x000000e1), propget, helpstring("Interface to PDElements collection")]
        HRESULT PDElements([out, retval] IPDElements** Value);
        [id(0x000000e2), propget]
        HRESULT Reclosers([out, retval] IReclosers** Value);
        [id(0x000000e3), propget]
        HRESULT Relays([out, retval] IRelays** Value);
        [id(0x000000e4), propget, helpstring("Interface to OpenDSS Load shapes currently defined.")]
        HRESULT LoadShapes([out, retval] ILoadShapes** Value);
        [id(0x000000e5), propget, helpstring("Return interface to Fuses ")]
        HRESULT Fuses([out, retval] IFuses** Value);
        [id(0x000000e6), propget, helpstring("Interface to ISOURCE devices")]
        HRESULT ISources([out, retval] IISources** Value);
        [id(0x000000e7), propget, helpstring("Complex array of actual node voltages in same order as SystemY matrix.")]
        HRESULT YNodeVarray([out, retval] VARIANT* Value);
        [id(0x000000e8), helpstring("Calls EndOfTimeStepCleanup in SolutionAlgs")]
        HRESULT EndOfTimeStepUpdate();
        [id(0x000000e9), propget]
        HRESULT DSSim_Coms([out, retval] IDSSimComs** Value);
        [id(0x000000ea), propget, helpstring("Variant array of strings containing the names of the nodes in the same order as the Y matrix")] // AltDSS element type: BSTR
        HRESULT YNodeOrder([out, retval] VARIANT* Value);
        [id(0x000000eb), propget, helpstring("Variant array of doubles containing complex injection currents for the present solution. Is is the \"I\" vector of I=YV")]
        HRESULT YCurrents([out, retval] VARIANT* Value);
        [id(0x000000ec), propget, helpstring("Interface to PVSystems collection")]
        HRESULT PVSystems([out, retval] IPVSystems** Value);
        [id(0x000000ed), propget, helpstring("Vsources object collection")]
        HRESULT Vsources([out, retval] IVsources** Value);
        [id(0x000000ee), propget, helpstring("Delivers a handler for the Parallel Dispatch interface")]
        HRESULT Parallel([out, retval] IParallel** Value);
        [id(0x000000ef), propget, helpstring("Access the Linecodes library in this circuit")]
        HRESULT LineCodes([out, retval] ILineCodes** Value);
        [id(0x000000f0), propget, helpstring("Connect to GICSources Interface")]
        HRESULT GICSources([out, retval] IGICSources** Value);
        [id(0x000000f1), propget, helpstring("Connect to the Circuit Reduction Interface")]
        HRESULT ReduceCkt([out, retval] IReduceCkt** Value);
        [id(0x000000f2), propget, helpstring("Connect to Storages Interface")]
        HRESULT Storages([out, retval] IStorages** Value);
        [id(0x000000f3), propget, helpstring("Connect to WindGens Interface")]
        HRESULT WindGens([out, retval] IWindGens** Value);
        [id(0x000000f4), propget, helpstring("Connect to Reactors Interface")]
        HRESULT Reactors([out, retval] IReactors** Value);

        // Added on DSS-Extensions (API Extensions)
        [id(0x00000a01), helpstring("Array of total losses (complex) in a selection of elements. Use the element indices (starting at 1) as parameter. **(API Extension)**")] // AltDSS element type: int32, float64
        HRESULT ElementLosses([in] VARIANT Elements, [out, retval] VARIANT* Value);
        [id(0x00000a02), helpstring("Returns data for all objects and basic circuit properties as a JSON-encoded string.\nThe `options` parameter contains bit-flags to toggle specific features.\nSee also the enum `DSSJSONFlags`.\nThe JSON data is organized using the JSON schema proposed at https://github.com/dss-extensions/AltDSS-Schema \n**(API Extension)**")]
        HRESULT ToJSON([in, defaultvalue(0)] long options, [out, retval] BSTR* Value);
        [id(0x00000a03), helpstring("Replaces the circuit, if any, with the one provided from a JSON-encoded string.\nThe expected layout is defined from the JSON schema proposed at https://github.com/dss-extensions/AltDSS-Schema \nThe `options` parameter contains bit-flags to toggle specific features. See the enum `DSSJSONFlags`.\n**(API Extension)**")]
        HRESULT FromJSON([in] BSTR data, [in] long options);
        [id(0x00000a04), helpstring("Equivalent of the `save circuit` DSS command, but allows customization through the `saveFlags` argument, which is a set of bit flags.\nSee the `DSSSaveFlags` enumeration for available flags.\nIf the `SingleFile` flag is enabled, the first argument (`dirOrFilePath`) is the file path, otherwise it is the folder path. For string output, the argument is not used.\n**(API Extension)**")]
        HRESULT Save([in] BSTR dirOrFilePath, [in, defaultvalue(0)] long saveFlags, [out, retval] BSTR* Value);
    };

    [
        uuid(C924B30A-18C2-11F0-A417-C87F5452571C),
