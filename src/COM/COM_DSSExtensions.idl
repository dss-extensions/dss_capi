        [id(0x000000db), propput, helpstring("Flag to indicate whether the circuit solution converged")]
        HRESULT Converged([in] VARIANT_BOOL Value);
        [id(0x000000dc), propget, helpstring("Total iterations including control iterations for most recent solution.")]
        HRESULT Totaliterations([out, retval] long* Value);
        [id(0x000000dd), propget, helpstring("Max number of iterations required to converge at any control iteration of the most recent solution.")]
        HRESULT MostIterationsDone([out, retval] long* Value);
        [id(0x000000de), propget, helpstring("Flag indicating the control actions are done.")]
        HRESULT ControlActionsDone([out, retval] VARIANT_BOOL* Value);
        [id(0x000000de), propput, helpstring("Flag indicating the control actions are done.")]
        HRESULT ControlActionsDone([in] VARIANT_BOOL Value);
        [id(0x000000df), helpstring("Call Cleanup, sample monitors, and increment time at end of time step.")]
        HRESULT FinishTimeStep();
        [id(0x000000e0), helpstring("Update storage, invcontrol, etc at end of time step")]
        HRESULT Cleanup();
        [id(0x000000e1), propget, helpstring("Gets the accumulated time of the simulation")]
        HRESULT Total_Time([out, retval] double* Value);
        [id(0x000000e1), propput, helpstring("Gets the accumulated time of the simulation")]
        HRESULT Total_Time([in] double Value);
        [id(0x000000e2), propget, helpstring("Gets the time required to perform the latest solution (Read only)")]
        HRESULT Process_Time([out, retval] double* Value);
        [id(0x000000e3), propget, helpstring("Get the solution process time + sample time for time step")]
        HRESULT Time_of_Step([out, retval] double* Value);
        [id(0x000000e4), propget, helpstring("Get/Set the Solution.IntervalHrs variable used for devices that integrate")]
        HRESULT IntervalHrs([out, retval] double* Value);
        [id(0x000000e4), propput, helpstring("Get/Set the Solution.IntervalHrs variable used for devices that integrate")]
        HRESULT IntervalHrs([in] double Value);
        [id(0x000000e5), helpstring("Solves the circuits for all the Actors created")]
        HRESULT SolveAll();
        [id(0x000000e6), propget] // AltDSS element type: int32
        HRESULT IncMatrix([out, retval] VARIANT* Value);
        [id(0x000000e7), propget] // AltDSS element type: BSTR
