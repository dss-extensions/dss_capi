    [
        odl,
        uuid(C924B31E-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for Bus Object"),
        hidden,
        dual,
        oleautomation
    ]
    interface IBus : IDispatch {
        [id(0x00000001), propget, helpstring("Name of Bus")]
        HRESULT Name([out, retval] BSTR* Name);
        [id(0x00000002), propget, helpstring("Number of Nodes this bus.")]
        HRESULT NumNodes([out, retval] long* NumNodes);
        [id(0x00000003), propget, helpstring("Complex array of voltages at this bus.")]
        HRESULT Voltages([out, retval] VARIANT* Voltages);
        [id(0x00000004), propget, helpstring("Double Array of sequence voltages at this bus.")]
        HRESULT SeqVoltages([out, retval] VARIANT* SeqVoltages);
        [id(0x00000005), propget, helpstring("Integer Array of Node Numbers defined at the bus in same order as the voltages.")] // AltDSS element type: int32
        HRESULT Nodes([out, retval] VARIANT* Nodes);
        [id(0x00000006), propget, helpstring("Open circuit voltage; Complex array.")]
        HRESULT Voc([out, retval] VARIANT* Voc);
        [id(0x00000007), propget, helpstring("Short circuit currents at bus; Complex Array.")]
        HRESULT Isc([out, retval] VARIANT* Isc);
        [id(0x00000008), propget, helpstring("Complex Array of pu voltages at the bus.")]
        HRESULT puVoltages([out, retval] VARIANT* Value);
        [id(0x00000009), propget, helpstring("Base voltage at bus in kV")]
        HRESULT kVBase([out, retval] double* Value);
        [id(0x0000000a), propget, helpstring("Complex array of Zsc matrix at bus. Column by column.")]
        HRESULT ZscMatrix([out, retval] VARIANT* Value);
        [id(0x0000000b), propget, helpstring("Complex Positive-Sequence short circuit impedance at bus..")]
        HRESULT Zsc1([out, retval] VARIANT* Value);
        [id(0x0000000c), propget, helpstring("Complex Zero-Sequence short circuit impedance at bus.")]
        HRESULT Zsc0([out, retval] VARIANT* Value);
        [id(0x0000000d), helpstring("Recomputes Zsc for active bus for present circuit configuration.")]
        HRESULT ZscRefresh([out, retval] VARIANT_BOOL* Value);
        [id(0x0000000e), propget, helpstring("Complex array of Ysc matrix at bus. Column by column.")]
        HRESULT YscMatrix([out, retval] VARIANT* Value);
        [id(0x000000c9), propget, helpstring("False=0 else True. Indicates whether a coordinate has been defined for this bus")]
        HRESULT Coorddefined([out, retval] VARIANT_BOOL* Value);
        [id(0x000000ca), propget, helpstring("X Coordinate for bus (double)")]
        HRESULT x([out, retval] double* Value);
        [id(0x000000ca), propput, helpstring("X Coordinate for bus (double)")]
        HRESULT x([in] double Value);
        [id(0x000000cb), propget, helpstring("Y coordinate for bus(double)")]
        HRESULT y([out, retval] double* Value);
        [id(0x000000cb), propput, helpstring("Y coordinate for bus(double)")]
        HRESULT y([in] double Value);
        [id(0x000000cc), propget, helpstring("Distance from energymeter (if non-zero)")]
        HRESULT Distance([out, retval] double* Value);
        [id(0x000000cd), helpstring("Returns a unique node number at the active bus to avoid node collisions and adds it to the node list for the bus.")]
        HRESULT GetUniqueNodeNumber([in] long StartNumber, [out, retval] long* Value);
        [id(0x000000ce), propget, helpstring("Complex Double array of Sequence Voltages (0, 1, 2) at this Bus.")]
        HRESULT CplxSeqVoltages([out, retval] VARIANT* Value);
        [id(0x000000cf), propget, helpstring("Accumulated failure rate downstream from this bus; faults per year")]
        HRESULT Lambda([out, retval] double* Value);
        [id(0x000000d0), propget, helpstring("Number of interruptions this bus per year")]
        HRESULT N_interrupts([out, retval] double* Value);
        [id(0x000000d1), propget, helpstring("Average interruption duration, hr.")]
        HRESULT Int_Duration([out, retval] double* Value);
        [id(0x000000d2), propget, helpstring("Annual number of customer-interruptions from this bus")]
        HRESULT Cust_Interrupts([out, retval] double* Value);
        [id(0x000000d3), propget, helpstring("Accumulated customer outage durations")]
        HRESULT Cust_Duration([out, retval] double* Value);
        [id(0x000000d4), propget, helpstring("Total numbers of customers served downline from this bus")]
        HRESULT N_Customers([out, retval] long* Value);
        [id(0x000000d5), propget, helpstring("For 2- and 3-phase buses, returns variant array of complex numbers representing L-L voltages in volts. Returns -1.0 for 1-phase bus. If more than 3 phases, returns only first 3.")]
        HRESULT VLL([out, retval] VARIANT* Value);
        [id(0x000000d6), propget, helpstring("Returns Complex array of pu L-L voltages for 2- and 3-phase buses. Returns -1.0 for 1-phase bus. If more than 3 phases, returns only 3 phases.")]
        HRESULT puVLL([out, retval] VARIANT* Value);
        [id(0x000000d7), propget, helpstring("Variant Array of doubles containing voltages in Magnitude (VLN), angle (deg) ")]
        HRESULT VMagAngle([out, retval] VARIANT* Value);
        [id(0x000000d8), propget, helpstring("Variant array of doubles containing voltage magnitude, angle pairs in per unit")]
        HRESULT puVmagAngle([out, retval] VARIANT* Value);
        [id(0x000000d9), propget, helpstring("Total length of line downline from this bus, in miles. For recloser siting algorithm.")]
        HRESULT TotalMiles([out, retval] double* Value);
        [id(0x000000da), propget, helpstring("Integer ID of the feeder section in which this bus is located.")]
        HRESULT SectionID([out, retval] long* Value);
        [id(0x000000db), propget, helpstring("Variant Array of Strings: List of LINE elements connected to this bus. Complete name Line.xxxx")] // AltDSS element type: BSTR
        HRESULT LineList([out, retval] VARIANT* Value);
        [id(0x000000dc), propget, helpstring("Variant array of strings: Full Names of LOAD elements connected to this bus.")] // AltDSS element type: BSTR
        HRESULT LoadList([out, retval] VARIANT* Value);
        [id(0x000000dd), propget, helpstring("Variant array of doubles (complex) containing the complete 012 Zsc matrix")]
        HRESULT ZSC012Matrix([out, retval] VARIANT* Value);
        [id(0x000000de), propget, helpstring("Sets the GIS latitude assigned to this bus")]
        HRESULT Latitude([out, retval] double* Value);
        [id(0x000000de), propput, helpstring("Sets the GIS latitude assigned to this bus")]
        HRESULT Latitude([in] double Value);
        [id(0x000000df), propget, helpstring("Sets the longitude given to the active Bus ")]
        HRESULT Longitude([out, retval] double* Value);
        [id(0x000000df), propput, helpstring("Sets the longitude given to the active Bus ")]
        HRESULT Longitude([in] double Value);
        [id(0x000000e0), propget, helpstring("Returns an array with the names of all PCE connected to the active bus")] // AltDSS element type: BSTR
        HRESULT AllPCEatBus([out, retval] VARIANT* Value);
        [id(0x000000e1), propget, helpstring("Returns an array with the names of all PDE connected to the active bus")] // AltDSS element type: BSTR
        HRESULT AllPDEatBus([out, retval] VARIANT* Value);
    };

