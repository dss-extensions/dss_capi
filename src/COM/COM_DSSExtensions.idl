        HRESULT LoadOpenDSS([in, defaultvalue("")] BSTR dllpath, [in, defaultvalue(0)] hyper liboptions);
        [id(0x00000a04), helpstring("Load AltDSS or a library that uses the AltDSS/C-API. Provide the file path for a specific DLL, or leave empty to use the internal DLL selection logic. Note: by default, AltDSS is already loaded when this COM module is created. **(API Extension)**")]
