    [
        odl,
        uuid(C924B3FA-18C2-11F0-A417-C87F5452571C),
        version(1.0),
        helpstring("Dispatch interface for Monitors Object"),
        dual,
        oleautomation
    ]
    interface IMonitors : IDispatch {
        [id(0x00000002), propget, helpstring("Array of all Monitor Names")] // AltDSS element type: BSTR
        HRESULT AllNames([out, retval] VARIANT* Value);
        [id(0x00000003), propget, helpstring("Sets the first Monitor active.  Returns 0 if no monitors.")]
        HRESULT First([out, retval] long* Value);
        [id(0x00000004), propget, helpstring("Sets next monitor active.  Returns 0 if no more.")]
        HRESULT Next([out, retval] long* Value);
        [id(0x00000005), helpstring("Resets active Monitor object.")]
        HRESULT Reset();
        [id(0x00000006), helpstring("Resets all Monitor Objects")]
        HRESULT ResetAll();
        [id(0x00000007), helpstring("Causes active Monitor to take a sample.")]
        HRESULT Sample();
        [id(0x00000008), helpstring("Causes active monitor to save its current sample buffer to its monitor stream. Then you can access the Bytestream or channel data. Most standard solution modes do this automatically.")]
        HRESULT Save();
        [id(0x00000009), helpstring("Converts monitor file to text and displays with text editor")]
        HRESULT Show();
        [id(0x0000000a), propget, helpstring("Name of CSV file associated with active Monitor.")]
        HRESULT FileName([out, retval] BSTR* Value);
        [id(0x0000000b), propget, helpstring("Set Monitor mode (bitmask integer - see DSS Help)")]
        HRESULT Mode([out, retval] long* Value);
        [id(0x0000000b), propput, helpstring("Set Monitor mode (bitmask integer - see DSS Help)")]
        HRESULT Mode([in] long Value);
        [id(0x00000001), propget, helpstring("Sets the active Monitor object by name")]
        HRESULT Name([out, retval] BSTR* Value);
        [id(0x00000001), propput, helpstring("Sets the active Monitor object by name")]
        HRESULT Name([in] BSTR Value);
        [id(0x0000000c), propget, helpstring("Byte Array containing monitor stream values. Make sure a \"save\" is done first (standard solution modes do this automatically)")] // AltDSS element type: int8
        HRESULT ByteStream([out, retval] VARIANT* Value);
        [id(0x0000000d), propget, helpstring("Number of Samples in Monitor at Present")]
        HRESULT SampleCount([out, retval] long* Value);
        [id(0x000000c9), helpstring("Causes all Monitors to take a sample of the present state")]
        HRESULT SampleAll();
        [id(0x000000ca), helpstring("Save all Monitor buffers to their respective file streams.")]
        HRESULT SaveAll();
        [id(0x000000cb), propget, helpstring("Number of Monitors")]
        HRESULT Count([out, retval] long* Value);
        [id(0x000000cc), helpstring("Post-process monitor samples taken so far, e.g., Pst for mode=4")]
        HRESULT Process();
        [id(0x000000cd), helpstring("All monitors post-process the data taken so far.")]
        HRESULT ProcessAll();
        [id(0x000000ce), propget, helpstring("Monitor File Version (integer)")]
        HRESULT FileVersion([out, retval] long* Value);
        [id(0x000000cf), propget, helpstring("Size of each record in ByteStream (Integer). Same as NumChannels.")]
        HRESULT RecordSize([out, retval] long* Value);
        [id(0x000000d0), propget, helpstring("Header string;  Variant array of strings containing Channel names")] // AltDSS element type: BSTR
        HRESULT Header([out, retval] VARIANT* Value);
        [id(0x000000d1), propget, helpstring("Variant array of doubles containing time value in hours for time-sampled monitor values; Empty if frequency-sampled values for harmonics solution  (see dblFreq)")]
        HRESULT dblHour([out, retval] VARIANT* Value);
        [id(0x000000d2), propget, helpstring("Variant array of doubles containing frequency values for harmonics mode solutions; Empty for time mode solutions (use dblHour)")]
        HRESULT dblFreq([out, retval] VARIANT* Value);
        [id(0x000000d3), propget, helpstring("Variant array of doubles for the specified channel  (usage: MyArray = DSSMonitor.Channel(i)) A Save or SaveAll  should be executed first. Done automatically by most standard solution modes.")]
        HRESULT Channel([in] long Index, [out, retval] VARIANT* Value);
        [id(0x000000d4), propget, helpstring("Number of Channels in the active Monitor")]
        HRESULT NumChannels([out, retval] long* Value);
        [id(0x000000d5), propget, helpstring("Full object name of element being monitored.")]
        HRESULT Element([out, retval] BSTR* Value);
        [id(0x000000d5), propput, helpstring("Full object name of element being monitored.")]
        HRESULT Element([in] BSTR Value);
        [id(0x000000d6), propget, helpstring("Terminal number of element being monitored")]
        HRESULT Terminal([out, retval] long* Value);
        [id(0x000000d6), propput, helpstring("Terminal number of element being monitored")]
        HRESULT Terminal([in] long Value);

        // Added on DSS-Extensions (API Extensions)
        [id(0x00000a01), propget, helpstring("Get/Set active Monitor by index.  1..Count **(API Extension)**")]
        HRESULT idx([out, retval] long* Value);
        [id(0x00000a01), propput, helpstring("Get/Set Monitor by index.  1..Count **(API Extension)**")]
        HRESULT idx([in] long Value);
    };

